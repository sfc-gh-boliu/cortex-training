{
  "sub_job_configs": [
    {
      "job_type": "training",
      "model_name": "Qwen/Qwen3-8B",
      "dtype": "bfloat16",
      "seed": 42,
      "training_config": {
        "n_gpus": 4,
        "max_seq_len": 2048,
        "train_batch_size": 64,
        "gradient_clipping": 1.0,
        "model_provider": "huggingface",
        "attn_implementation": "flash_attention_3",
        "mb_spec": {
          "max_tokens_per_mb": 4096
        },
        "optimizer": {
          "name": "AdamW",
          "lr": 1e-05,
          "weight_decay": 0.0,
          "betas": [
            0.9,
            0.95
          ],
          "eps": 1e-08
        },
        "ds_config": {
          "zero_optimization": {
            "stage": 2
          },
          "bf16": {
            "enabled": true
          }
        },
        "peft_config": {
          "peft_type": "Lora",
          "r": 16,
          "lora_alpha": 16,
          "lora_dropout": 0.0,
          "bias": "none",
          "target_modules": [
            "q_proj",
            "k_proj",
            "v_proj",
            "o_proj",
            "gate_proj",
            "up_proj",
            "down_proj"
          ]
        },
        "activation_checkpointing": true
      }
    }
  ]
}
